# ============================================================
#  绝不能入库的文件（开源安全红线）
# ============================================================

# 签名密钥：一旦公开，任何人都能伪造你的应用"升级包"
*.jks
*.keystore
keystore.properties

# 密钥的备份 / 临时副本。
# 更换口令时产生过 subblock.jks.bak-weakpass —— 文件名不以 .jks 结尾，
# 会被上面的 *.jks 规则漏掉。这几条是补漏的兜底网。
*.jks.*
*.keystore.*
*.bak
app/keystore/

# 本机专属配置：记录着各人电脑上的 Android SDK 路径
local.properties

# ============================================================
#  构建产物
# ============================================================
.gradle/
build/
app/build/
*.apk
*.aab
*.ap_
*.dex
output.json
release/
captures/
.cxx/
.externalNativeBuild/

# ============================================================
#  编辑器 / IDE
# ============================================================
.idea/
*.iml
*.iws
*.hprof
.vscode/

# ============================================================
#  操作系统
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
