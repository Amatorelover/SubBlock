    <string name="about_section_author">Author statement</string>
    <string name="about_author_p1">SubBlock grew out of a small need: watching videos without the burned-in subtitles covering the picture, while every tool I could find was either abandoned or limited to one fixed area. So I wrote my own.</string>
    <string name="about_author_p2">It does exactly one thing: draw a mask wherever you tell it to. It does not read your screen, does not run text recognition, and never modifies or downloads any video.</string>
    <string name="about_author_p3">This project is open-sourced under the MIT License and is meant for personal learning and personal use. You are responsible for making sure your use complies with local laws and the terms of the services you use; any consequences of using this software are yours to bear.</string>

    <string name="about_section_privacy">Privacy</string>
    <string name="about_privacy_1">No network permission — check AndroidManifest.xml yourself, there is no INTERNET</string>
    <string name="about_privacy_2">No data collection: no analytics, no tracking, no ads, no accounts</string>
    <string name="about_privacy_3">All configuration is stored on your own device</string>

    <string name="about_section_opensource">Open source</string>
    <string name="about_opensource_body">The full source code is public. Issues and pull requests are welcome:</string>
